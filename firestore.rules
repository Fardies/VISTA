rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Operator account already created in Firebase Authentication.
    // Only this exact signed-in email/password identity has operator access.
    // If you change operator email, update this value and republish rules.
    function isOperator() {
      return request.auth != null
        && request.auth.token.email == 'operator@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isVisitor() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    match /visits/{visitId} {
      allow get: if isOperator() ||
        (isVisitor() && resource.data.ownerUid == request.auth.uid);
      allow list: if isOperator();
      allow create: if isVisitor()
        && request.resource.data.keys().hasOnly(['ownerUid','name','purpose','car','inAt','outAt'])
        && request.resource.data.keys().hasAll(['ownerUid','name','purpose','car','inAt','outAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0
        && request.resource.data.purpose.size() <= 120
        && request.resource.data.car is string
        && request.resource.data.car.size() <= 20
        && request.resource.data.inAt == request.time
        && request.resource.data.outAt == null;
      // NEW: the operator (guard) can create a visit manually for a visitor
      // who cannot check in themselves (e.g. phone battery is dead).
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(['ownerUid','name','purpose','car','inAt','outAt','source'])
        && request.resource.data.keys().hasAll(['ownerUid','name','purpose','car','inAt','outAt','source'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.source == 'guard'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0
        && request.resource.data.purpose.size() <= 120
        && request.resource.data.car is string
        && request.resource.data.car.size() <= 20
        && request.resource.data.inAt == request.time
        && request.resource.data.outAt == null;
      allow update: if (isOperator() ||
          (isVisitor() && resource.data.ownerUid == request.auth.uid))
        && resource.data.outAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt'])
        && request.resource.data.outAt == request.time;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
