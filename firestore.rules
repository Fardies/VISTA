rules_version = '2';
// VISTA Firestore security rules (face check-in version).
// Publish: Firebase Console > Firestore Database > Rules > paste > Publish,
// or `firebase deploy --only firestore:rules`.
//
// Flow (Option A): visitor registers (pending) -> guard checks in (face or manual)
// -> guard checks out (face or manual). All in the SAME visits/{visitId} record.
// Face templates are written and read ONLY by Cloud Functions (Admin SDK), which
// bypass these rules. Browsers can never read or write faceTemplates.
service cloud.firestore {
  match /databases/{database}/documents {
    // Operator account in Firebase Authentication. If you change this email,
    // also change OPERATOR_EMAIL in guard.js and functions/index.js.
    function isOperator() {
      return request.auth != null
        && request.auth.token.email == 'operator@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isVisitor() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validDetails(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.purpose is string && d.purpose.size() > 0 && d.purpose.size() <= 120
        && d.car is string && d.car.size() <= 20;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Records made before the pending flow have no status; treat "no check-out" as inside.
    function isInside() {
      return resource.data.get('status', null) == 'in'
        || (resource.data.get('status', null) == null && resource.data.outAt == null);
    }

    match /visits/{visitId} {
      allow get: if isOperator()
        || (isVisitor() && resource.data.ownerUid == request.auth.uid);
      allow list: if isOperator();

      // 1. Visitor registration from the QR page: pending, no check-in time yet.
      allow create: if isVisitor()
        && request.resource.data.keys().hasOnly(['ownerUid','name','purpose','car','status','createdAt','inAt','outAt','faceConsent'])
        && request.resource.data.keys().hasAll(['ownerUid','name','purpose','car','status','createdAt','inAt','outAt','faceConsent'])
        && request.resource.data.ownerUid == request.auth.uid
        && validDetails(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.inAt == null
        && request.resource.data.outAt == null
        && request.resource.data.faceConsent is bool;

      // 2. Walk-in visitor registered by the guard: checked in immediately, manual only.
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(['ownerUid','name','purpose','car','status','createdAt','inAt','outAt','source','faceConsent','checkInMethod'])
        && request.resource.data.keys().hasAll(['ownerUid','name','purpose','car','status','createdAt','inAt','outAt','source','faceConsent'])
        && request.resource.data.ownerUid == request.auth.uid
        && validDetails(request.resource.data)
        && request.resource.data.source == 'guard'
        && request.resource.data.status == 'in'
        && request.resource.data.createdAt == request.time
        && request.resource.data.inAt == request.time
        && request.resource.data.outAt == null
        && request.resource.data.faceConsent == false
        && request.resource.data.get('checkInMethod', 'walk-in') == 'walk-in';

      // 3. Guard actions.
      //    'manual'     = guard pressed Check In / Check-Out.
      //    'face-local' = PROTOTYPE · Local Face Matching: the face was matched on the
      //                   guard's phone; no face data is stored in Firestore.
      //    'face'       = Cloud Functions (Blaze) only; browsers can never set it.
      allow update: if isOperator() && (
        // Check-in: pending -> in (face-local only for visitors who consented)
        (resource.data.get('status', null) == 'pending'
          && changed().hasOnly(['status','inAt','checkInMethod'])
          && request.resource.data.status == 'in'
          && request.resource.data.inAt == request.time
          && (request.resource.data.checkInMethod == 'manual'
            || (request.resource.data.checkInMethod == 'face-local' && resource.data.faceConsent == true)))
        // Cancel a registration that never arrived: pending -> cancelled
        || (resource.data.get('status', null) == 'pending'
          && changed().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
        // Check-out: in -> out
        || (isInside()
          && changed().hasOnly(['status','outAt','checkOutMethod'])
          && request.resource.data.status == 'out'
          && request.resource.data.outAt == request.time
          && request.resource.data.checkOutMethod in ['manual', 'face-local'])
      );

      // Visitors cannot change a record after registering. Nobody can delete records.
      allow delete: if false;
    }

    // Biometric face templates: Cloud Functions only. No browser access at all.
    match /faceTemplates/{visitId} {
      allow read, write: if false;
    }

    // Face audit log (scores and outcomes, no biometric data). Read-only for the
    // operator, used to calibrate the match threshold.
    match /faceEvents/{eventId} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
